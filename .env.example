# Registration gate: /api/quote and /api/register only work when this is exactly "true".
REGISTRATION_OPEN=false
# Receives payments. Required for /api/quote.
TREASURY_WALLET=
# Mint authority secret key. Required to mint.
MINT_AUTHORITY_KEYPAIR=
# Optional. Metaplex Core collection for minted names. Leave empty: when set, owns-teos and register only count assets in this collection.
# Optional. There is no collection; leave unset. Ownership is checked by name + our authority or registry mint.
COLLECTION_ADDRESS=
# Optional, comma separated: extra update authorities that count as ours (besides the mint key).
TEOS_UPDATE_AUTHORITY=
# Public founder wallet (public address only, never a secret). Used by /founder to list NFT / cNFT.
NEXT_PUBLIC_FOUNDER_WALLET=
# Public core wallet (public address only, never a secret).
NEXT_PUBLIC_CORE_WALLET=
# Public mint wallet (public address only, never a secret). Display-only on /founder; never used for auth.
NEXT_PUBLIC_MINT_WALLET=
# Public receiver / treasury wallet (public address only, never a secret).
# Display only: quotes and payment verification still use the server-side TREASURY_WALLET.
NEXT_PUBLIC_RECEIVER_WALLET=
HELIUS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Founder dashboard (generate both with: npm run hash-password) ---
# scrypt hash of the founder password. Replaces the old plaintext FOUNDER_PASSWORD (delete that one).
FOUNDER_PASSWORD_HASH=
# 32+ random characters. Shorter values are treated as "not configured".
FOUNDER_SESSION_SECRET=
# Public site URL (used for the CSRF origin check and NFT metadata links).
PUBLIC_BASE_URL=https://web4.elmahrosa.org
# Emergency switch: set to 1 to send the CSP as Report-Only while debugging a wallet flow. Leave unset in normal operation.
CSP_REPORT_ONLY=
# Optional. Slack/Discord-style webhook POSTed (max once per 30 min) when more than 10 paid mints wait in teos:pending-mints.
ALERT_WEBHOOK_URL=
