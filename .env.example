# Registration gate: /api/quote and /api/register only work when this is exactly "true".
REGISTRATION_OPEN=false
# Receives payments. Required for /api/quote.
TREASURY_WALLET=
# Mint authority secret key. Required to mint.
MINT_AUTHORITY_KEYPAIR=
# Optional. Metaplex Core collection for minted names. Leave empty: when set, owns-teos and register only count assets in this collection.
COLLECTION_ADDRESS=
HELIUS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
